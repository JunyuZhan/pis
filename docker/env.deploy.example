# =============================================================================
# PIS 部署用环境变量（复制为与 docker-compose.yml 同目录下的 .env）
# 命令：cp docker/env.deploy.example docker/.env   然后编辑 docker/.env
# 或在项目根已有 .env 时：cd docker && ln -sf ../.env .env
# 完整说明与开发用变量见仓库根目录 .env.example
# =============================================================================

DOMAIN=localhost

# 数据库（与 postgres 容器 POSTGRES_PASSWORD 一致）
POSTGRES_DB=pis
POSTGRES_USER=pis
DATABASE_PASSWORD=请改为强密码
POSTGRES_PASSWORD=请改为强密码

# 应用密钥（请改为随机长字符串）
AUTH_JWT_SECRET=请改为至少32字符
ALBUM_SESSION_SECRET=请改为至少32字符
WORKER_API_KEY=请改为至少32字符

# MinIO 根账号（对象存储）
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=请改为强密码

# 对外访问（按实际域名修改）
NEXT_PUBLIC_APP_URL=http://localhost:8088
NEXT_PUBLIC_MEDIA_URL=http://localhost:8088/media
NEXT_PUBLIC_WORKER_URL=http://localhost:8088/worker-api

# 可选：覆盖默认拉取的 Web / Worker 镜像（与 docker compose 中默认值一致时可不填）
# PIS_WEB_IMAGE=hub.albertzhan.top/pis/web:latest
# PIS_WORKER_IMAGE=hub.albertzhan.top/pis/worker:latest
